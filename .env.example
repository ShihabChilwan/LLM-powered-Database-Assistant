# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so your key is never committed.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: override the defaults in app/config.py
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.3-flash
EMBEDDING_MODEL=openai/text-embedding-3-small

# Not settable here: MAX_TURNS, MAX_SQL_ROWS, TOP_K and MIN_SCORE are plain
# constants in app/config.py, because they are design choices, not per-machine
# settings.
